              "name": "nutriScore",
              "value": "={{ $json.product.nutriscore_grade }}",
              "type": "string"
            },
            {
              "id": "4ecda7d6-e6dd-457a-88aa-3d85659f4d37",
              "name": "=azucar",
              "value": "={{ $json.product.nutriments.sugars_100g }}",
              "type": "number"
            },
            {
              "id": "3714fedc-57b9-432b-a9b3-e6767e6ddf6b",
              "name": "=sal",
              "value": "={{ $json.product.nutriments.salt_100g }}",
              "type": "number"
            },
            {
              "id": "4b6ba8fa-2209-482d-8c80-71ce6a050506",
              "name": "=grasa",
              "value": "={{ $json.product.nutriments.fat_100g }}",
              "type": "number"
            },
            {
              "id": "359e8824-a2c4-42c9-a3da-0867b39eadae",
              "name": "=kalorias",
              "value": "={{ $json.product.nutriments['energy-kcal_100g'] }}",
              "type": "number"
            },
            {
              "id": "d54016be-a478-452a-a1e9-3367ba2e9455",
              "name": "=nivel_azucar",
              "value": "={{ Number($json.product.nutriments.sugars_100g ?? 0) < 5 ? 0 : Number($json.product.nutriments.sugars_100g ?? 0) <= 22.5 ? 1 : 2 }}",
              "type": "number"
            },
            {
              "id": "a9d969ea-c7f3-49b9-afb7-1f938ffe496d",
              "name": "=nivel_sal",
              "value": "={{ Number($json.product.nutriments.salt_100g ?? 0) > 1.5 ? 2 : 0 }}",
              "type": "number"
            },
            {
              "id": "2e7e3533-dda7-4360-bef2-9758e0f60317",
              "name": "=nivel_grasa",
              "value": "={{ Number($json.product.nutriments.fat_100g ?? 0) > 17.5 ? 2 : 0 }}",
              "type": "number"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        320,
        1504
      ],
      "id": "b2595ae7-1313-4964-85e1-701413ca9636",
      "name": "Asignar-variables"
    },
    {
      "parameters": {
        "jsCode": "// Obtener los niveles de azúcar, sal y grasa\nconst nivelAzucar = Number($json.nivel_azucar);\nconst nivelSal = Number($json.nivel_sal);\nconst nivelGrasa = Number($json.nivel_grasa);\n\n// 1. Calcular conteo_semaforo\nconst conteo_semaforo =  nivelAzucar + nivelSal + nivelGrasa;\n\n// 2. Calcular nivel_nutriScore\nconst nutriScoreGrade = String($json.nutriScore ?? '').toLowerCase();\n\nlet nivel_nutriScore;\n\nif (['a', 'b', ''].includes(nutriScoreGrade)) {  nivel_nutriScore = 0;} \n  else if (nutriScoreGrade === 'c') {nivel_nutriScore = 1;} \n  else if (['d', 'e'].includes(nutriScoreGrade)) {nivel_nutriScore = 2;}\n  else {nivel_nutriScore = 0;}\n\n// 3. Calcular Puntuacion_preocupacion (máximo 3)\nconst preocupacion = Math.min(conteo_semaforo,3);\n\n// Devolver todos los campos originales y los nuevos\nreturn [\n  {\n    json: {\n      ...$json,\n      conteo_semaforo,\n      nivel_nutriScore,\n      preocupacion\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        544,
        1504
      ],
      "id": "cf4e446b-0e87-4b35-940f-1bb4dceab980",
      "name": "Calculo_semaforo_nivelNS_Preocupacion"
    },
    {
      "parameters": {
        "assignments": {
